  <flight_control name="Phoenix command adaptation">
    <property>fcs/left-elevon-cmd-norm</property>
    <property>fcs/right-elevon-cmd-norm</property>
    <channel name="Elevons">
      <pure_gain name="fcs/left-elevon-pos-rad">
        <input>fcs/left-elevon-cmd-norm</input>
        <gain>0.53</gain>
        <clipto>
          <min>-0.53</min>
          <max>0.53</max>
        </clipto>
      </pure_gain>
      <pure_gain name="fcs/right-elevon-pos-rad">
        <input>fcs/right-elevon-cmd-norm</input>
        <gain>0.53</gain>
        <clipto>
          <min>-0.53</min>
          <max>0.53</max>
        </clipto>
      </pure_gain>
    </channel>
    <channel name="Twin motors">
      <lag_filter name="fcs/left-motor-pos-norm">
        <input>fcs/left-motor-cmd-norm</input>
        <c1>55.555556</c1>
        <clipto>
          <min>0.0</min>
          <max>1.0</max>
        </clipto>
      </lag_filter>
      <lag_filter name="fcs/right-motor-pos-norm">
        <input>fcs/right-motor-cmd-norm</input>
        <c1>55.555556</c1>
        <clipto>
          <min>0.0</min>
          <max>1.0</max>
        </clipto>
      </lag_filter>
    </channel>
  </flight_control>
  <aerodynamics>
    <function name="aero/tddt-wing-blend">
      <table>
        <independentVar lookup="row">velocities/u-aero-fps</independentVar>
        <tableData>
-98.4251968504 0
0 0
29.8556430446 0
31.1679790026 0.0518266431588
32.8083989501 0.229160687195
34.4488188976 0.474148181557
36.0892388451 0.725285989585
37.7296587927 0.92107097462
39.3700787402 1
98.4251968504 1
</tableData>
      </table>
    </function>
    <axis name="LIFT">
      <function name="aero/force/lift">
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <sum>
            <value>0.10</value>
            <product>
              <value>3.40</value>
              <property>aero/alpha-rad</property>
            </product>
            <product>
              <value>2.50</value>
              <property>aero/ci2vel</property>
              <property>velocities/q-aero-rad_sec</property>
            </product>
            <product>
              <value>0.225</value>
              <sum>
                <property>fcs/left-elevon-pos-rad</property>
                <property>fcs/right-elevon-pos-rad</property>
              </sum>
            </product>
          </sum>
          <property>aero/tddt-wing-blend</property>
        </product>
      </function>
    </axis>
    <axis name="DRAG">
      <function name="aero/force/drag">
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <sum>
            <value>0.045</value>
            <product>
              <value>0.134</value>
              <sum>
                <value>0.10</value>
                <product>
                  <value>3.40</value>
                  <property>aero/alpha-rad</property>
                </product>
              </sum>
              <sum>
                <value>0.10</value>
                <product>
                  <value>3.40</value>
                  <property>aero/alpha-rad</property>
                </product>
              </sum>
            </product>
          </sum>
          <property>aero/tddt-wing-blend</property>
        </product>
      </function>
    </axis>
    <axis name="SIDE">
      <function name="aero/force/side">
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <value>-0.35</value>
          <property>aero/beta-rad</property>
          <property>aero/tddt-wing-blend</property>
        </product>
      </function>
    </axis>
    <axis name="ROLL">
      <function name="aero/moment/roll">
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <property>metrics/bw-ft</property>
          <sum>
            <product>
              <value>-0.08</value>
              <property>aero/beta-rad</property>
            </product>
            <product>
              <value>-0.45</value>
              <property>aero/bi2vel</property>
              <property>velocities/p-aero-rad_sec</property>
            </product>
            <product>
              <value>0.09</value>
              <sum>
                <property>fcs/right-elevon-pos-rad</property>
                <product>
                  <value>-1.0</value>
                  <property>fcs/left-elevon-pos-rad</property>
                </product>
              </sum>
            </product>
          </sum>
          <property>aero/tddt-wing-blend</property>
        </product>
      </function>
    </axis>
    <axis name="PITCH">
      <function name="aero/moment/pitch">
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <property>metrics/cbarw-ft</property>
          <sum>
            <value>0.02</value>
            <product>
              <value>-0.55</value>
              <property>aero/alpha-rad</property>
            </product>
            <product>
              <value>-5.0</value>
              <property>aero/ci2vel</property>
              <property>velocities/q-aero-rad_sec</property>
            </product>
            <product>
              <value>-0.40</value>
              <sum>
                <property>fcs/left-elevon-pos-rad</property>
                <property>fcs/right-elevon-pos-rad</property>
              </sum>
            </product>
          </sum>
          <property>aero/tddt-wing-blend</property>
        </product>
      </function>
    </axis>
    <axis name="YAW">
      <function name="aero/moment/yaw">
        <product>
          <property>aero/qbar-psf</property>
          <property>metrics/Sw-sqft</property>
          <property>metrics/bw-ft</property>
          <sum>
            <product>
              <value>0.08</value>
              <property>aero/beta-rad</property>
            </product>
            <product>
              <value>-0.18</value>
              <property>aero/bi2vel</property>
              <property>velocities/r-aero-rad_sec</property>
            </product>
          </sum>
          <property>aero/tddt-wing-blend</property>
        </product>
      </function>
    </axis>
  </aerodynamics>
