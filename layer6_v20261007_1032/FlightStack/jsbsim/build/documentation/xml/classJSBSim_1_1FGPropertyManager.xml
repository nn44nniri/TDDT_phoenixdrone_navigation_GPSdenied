      <memberdef kind="function" id="classJSBSim_1_1FGPropertyManager_1ad1b481030ac71651e903c2acb29f506d" prot="public" static="no" const="no" explicit="no" inline="yes" virt="non-virtual">
        <templateparamlist>
          <param>
            <type>class T</type>
          </param>
          <param>
            <type>class V</type>
          </param>
        </templateparamlist>
        <type>void</type>
        <definition>void Tie</definition>
        <argsstring>(const std::string &amp;name, T *obj, int index, V(T::*getter)(int) const, void(T::*setter)(int, V)=nullptr)</argsstring>
        <name>Tie</name>
        <qualifiedname>JSBSim::FGPropertyManager::Tie</qualifiedname>
        <param>
          <type>const std::string &amp;</type>
          <declname>name</declname>
        </param>
        <param>
          <type>T *</type>
          <declname>obj</declname>
        </param>
        <param>
          <type>int</type>
          <declname>index</declname>
        </param>
        <param>
          <type>V(T::*)(int) const</type>
          <declname>getter</declname>
        </param>
        <param>
          <type>void(T::*)(int, V)</type>
          <declname>setter</declname>
          <defval>nullptr</defval>
        </param>
        <briefdescription>
<para>Tie a property to a pair of indexed object methods. </para>
        </briefdescription>
        <detaileddescription>
<para>Every time the property value is queried, the getter (if any) will be invoked with the index provided; every time the property value is modified, the setter (if any) will be invoked with the index provided. The getter can be 0 to make the property unreadable, and the setter can be 0 to make the property unmodifiable.</para>
<para><parameterlist kind="param"><parameteritem>
<parameternamelist>
<parametername>name</parametername>
</parameternamelist>
<parameterdescription>
<para>The property name to tie (full path). </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>obj</parametername>
</parameternamelist>
<parameterdescription>
<para>The object whose methods should be invoked. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>index</parametername>
</parameternamelist>
<parameterdescription>
<para>The integer argument to pass to the getter and setter methods. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>getter</parametername>
</parameternamelist>
<parameterdescription>
<para>The getter method, or 0 if the value is unreadable. </para>
</parameterdescription>
</parameteritem>
<parameteritem>
<parameternamelist>
<parametername>setter</parametername>
</parameternamelist>
<parameterdescription>
<para>The setter method, or 0 if the value is unmodifiable. </para>
</parameterdescription>
</parameteritem>
</parameterlist>
</para>
        </detaileddescription>
        <inbodydescription>
        </inbodydescription>
        <location file="/media/p1/DigitalTwin/TDDT_navigation/arduPilot/Layer6/layer6_v20261007_1032/FlightStack/jsbsim/src/input_output/FGPropertyManager.h" line="333" column="5" bodyfile="/media/p1/DigitalTwin/TDDT_navigation/arduPilot/Layer6/layer6_v20261007_1032/FlightStack/jsbsim/src/input_output/FGPropertyManager.h" bodystart="333" bodyend="358"/>
