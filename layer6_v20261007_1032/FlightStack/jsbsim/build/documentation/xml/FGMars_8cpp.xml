<codeline lineno="70"><highlight class="normal">{</highlight></codeline>
<codeline lineno="71"><highlight class="normal"><sp/><sp/></highlight><highlight class="comment">//Calculate<sp/>reftemp,<sp/>refpress,<sp/>and<sp/>density</highlight><highlight class="normal"></highlight></codeline>
<codeline lineno="72"><highlight class="normal"></highlight></codeline>
<codeline lineno="73"><highlight class="normal"><sp/><sp/></highlight><highlight class="comment">//<sp/>LIMIT<sp/>the<sp/>temperatures<sp/>so<sp/>they<sp/>do<sp/>not<sp/>descend<sp/>below<sp/>absolute<sp/>zero.</highlight><highlight class="normal"></highlight></codeline>
<codeline lineno="74"><highlight class="normal"></highlight></codeline>
<codeline lineno="75"><highlight class="normal"><sp/><sp/></highlight><highlight class="keywordflow">if</highlight><highlight class="normal"><sp/>(altitude<sp/>&lt;<sp/>22960.0)<sp/>{</highlight></codeline>
<codeline lineno="76"><highlight class="normal"><sp/><sp/><sp/><sp/>Temperature<sp/>=<sp/>-25.68<sp/>-<sp/>0.000548*altitude<sp/>+<sp/>459.67;<sp/></highlight><highlight class="comment">//<sp/>Convert<sp/>F<sp/>to<sp/>Rankine</highlight><highlight class="normal"></highlight></codeline>
<codeline lineno="77"><highlight class="normal"><sp/><sp/>}<sp/></highlight><highlight class="keywordflow">else</highlight><highlight class="normal"><sp/>{</highlight></codeline>
<codeline lineno="78"><highlight class="normal"><sp/><sp/><sp/><sp/>Temperature<sp/>=<sp/>-10.34<sp/>-<sp/>0.001217*altitude<sp/>+<sp/>459.67;<sp/></highlight><highlight class="comment">//<sp/>Convert<sp/>F<sp/>to<sp/>Rankine</highlight><highlight class="normal"></highlight></codeline>
<codeline lineno="79"><highlight class="normal"><sp/><sp/>}</highlight></codeline>
<codeline lineno="80"><highlight class="normal"><sp/><sp/>Pressure<sp/>=<sp/>14.62*exp(-0.00003*altitude);<sp/></highlight><highlight class="comment">//<sp/>psf<sp/>-<sp/>14.62<sp/>psf<sp/>=~<sp/>7<sp/>millibars</highlight><highlight class="normal"></highlight></codeline>
<codeline lineno="81"><highlight class="normal"><sp/><sp/>Density<sp/>=<sp/>Pressure/(Reng*Temperature);<sp/></highlight><highlight class="comment">//<sp/>slugs/ft^3<sp/>(needs<sp/>deg<sp/>R.<sp/>as<sp/>input</highlight><highlight class="normal"></highlight></codeline>
