def test_full_fidelity_bridge_does_not_treat_layer4_abstract_actions_as_qlpv_correction(tmp_path,monkeypatch):
    clear_layer5_modules(); monkeypatch.delenv("TDDT_LAYER5_ROOT",raising=False)
    l5=make_fake_layer5(tmp_path); cfg=make_cfg(tmp_path,l5); a=Layer5Adapter(cfg); a._ensure()
    seen={}
    class Phoenix:
        LOGICAL_ORDER=['a','e','t','r']; PHYSICAL_ACTUATORS=['le','re','lm','rm']
        def status(self): return {'nominal_control_ready':True}
        def bind_candidate(self,c): return [[0.1,0.2,0.3,0.0]], {'ok':True,'source':'tracker'}
        def physical_trajectory_feasibility(self,seq,correction_requested=False): seen['correction']=correction_requested; return {'ok':True,'reasons':[]}
        def mix_physical(self,u): return {'ok':True,'physical':[0.1,-0.1,0.3,0.3]}
    a.engine.phoenix=Phoenix()
    out=a.full_fidelity_action_bridge({'actions':[[9,8,7,6,5]]})
    assert out['ok'] is True and seen['correction'] is False
    clear_layer5_modules()

def test_layer6_commissioning_applies_ptlib_certificate_to_layer5(tmp_path,monkeypatch):
    clear_layer5_modules(); monkeypatch.delenv("TDDT_LAYER5_ROOT",raising=False); monkeypatch.delenv("TDDT_PTLIB_ROOT",raising=False)
    l5=make_fake_layer5(tmp_path); ptroot=make_fake_ptlib(tmp_path); cfg=make_cfg(tmp_path,l5,ptroot); monkeypatch.setenv("TDDT_PTLIB_ROOT",str(ptroot))
    a5=Layer5Adapter(cfg); applied={}
    def apply(cert): applied['cert']=cert; return {'ok':True,'accepted':True}
    a5.apply_online_control_certificate=apply
    a6=Layer6OnlineAdapter(cfg,a5)
    cert={'schema':'PTLIB-Phoenix-control-commission-v2','ok':True,'sitl_only':True,'physics_held_during_commissioning':True}
    a5.online_phase_commissioning_requests=lambda: {
        'ok':True,'requests':{'vertical_takeoff':{'operating_request_norm':0.75}}
    }
    class P:
        def probe(self): return {'ok':True}
        def prepare(self): return {'ok':True,'prepared':True}
        def connect(self): return {'ok':True,'connected':True}
        def prepare_control_session(self): return {'ok':True,'ready':True}
        def commission_control_path(self,phase_throttle_requests=None):
            assert phase_throttle_requests=={'vertical_takeoff':{'operating_request_norm':0.75}}
            return cert
        def close(self): pass
    a6._pt=P()
    out=a6.commission_online_control()
    assert out['ok'] is True and applied['cert']==cert
    clear_layer5_modules()


def test_layer6_demo_aligned_prepare_delegates_before_commission(tmp_path,monkeypatch):
