def test_online_layer7_feedback_is_consumed_by_layer2_on_next_cycle(tmp_path,monkeypatch):
    clear_layer5_modules(); Fake2.calls=[]; monkeypatch.delenv('TDDT_LAYER5_ROOT',raising=False)
    l5=make_fake_layer5(tmp_path); pt=make_fake_ptlib(tmp_path); cfg=make_cfg(tmp_path,l5,pt); monkeypatch.setenv('TDDT_PTLIB_ROOT',str(pt)); cfg.data['layers']['layer7']['enabled']=True
    o=TDOCOrchestrator(cfg); f2=Fake2(); o.adapters[2]=f2; o.adapters[3]=Fake3(); o.adapters[4]=Fake4(); o.adapters[7]=Fake7()
    try:
        off=o.run_cycle({'transaction_id':'offline-loop-seed','reference_time_s':1.0,'learning_mode':'OFFLINE_SE','context':{}}).to_dict()
        assert off['status']=='OK'; assert o.finalize_offline_knowledge({'test':True})['ok']
        run={'run_id':'feedback-run','episode_id':'feedback-episode','mission_version':'test-v1','phase_id':'on_ground'}
        first=o.run_cycle({'transaction_id':'online-loop-1','reference_time_s':2.0,'stage':'on_ground','learning_mode':'ONLINE_JSBSIM','online_training':True,'require_offline_knowledge':True,'context':{'rtmo_run_context':{**run,'cycle_id':1}}}).to_dict()
        assert first['downstream_layers']['7']['status']=='OK'
        second=o.run_cycle({'transaction_id':'online-loop-2','reference_time_s':3.0,'stage':'on_ground','learning_mode':'ONLINE_JSBSIM','online_training':True,'require_offline_knowledge':True,'context':{'rtmo_run_context':{**run,'cycle_id':2}}}).to_dict()
    finally:
        o.close(); clear_layer5_modules()
    ctx=(f2.calls[-1].get('context') or {})
    assert 'layer7_feedback' in ctx and 'Layer2' in ctx['layer7_feedback']
    ingress=((second.get('provenance') or {}).get('online_previous_layer7_feedback') or {}).get('layer2_ingress') or {}
    assert ingress.get('present') is True and ingress.get('consumed') is True and ingress.get('delta_x_present') is True
    assert second['conformance']['A_online_previous_l7_ingress_to_l2'] is True

def test_online_layer7_no_change_is_acknowledged_by_layer2_once_without_persistence(tmp_path,monkeypatch):
    clear_layer5_modules(); Fake2.calls=[]; monkeypatch.delenv('TDDT_LAYER5_ROOT',raising=False)
    l5=make_fake_layer5(tmp_path); pt=make_fake_ptlib(tmp_path); cfg=make_cfg(tmp_path,l5,pt); monkeypatch.setenv('TDDT_PTLIB_ROOT',str(pt)); cfg.data['layers']['layer7']['enabled']=True
    class NoChange7(Fake7):
        def invoke(self,payload):
            return {"ok":True,"status":"OK","result":{"feedback_layer2":{},"feedback_layer31":{},"feedback_layer32":{},"feedback_layer33":{},"commit":{"status":"NO_CHANGE"}}}
    o=TDOCOrchestrator(cfg); f2=Fake2(); o.adapters[2]=f2; o.adapters[3]=Fake3(); o.adapters[4]=Fake4(); o.adapters[7]=NoChange7()
    try:
        off=o.run_cycle({'transaction_id':'offline-no-change-seed','reference_time_s':1.0,'learning_mode':'OFFLINE_SE','context':{}}).to_dict()
        assert off['status']=='OK'; assert o.finalize_offline_knowledge({'test':True})['ok']
        run={'run_id':'no-change-run','episode_id':'no-change-episode','mission_version':'test-v1','phase_id':'on_ground'}
        first=o.run_cycle({'transaction_id':'online-no-change-1','reference_time_s':2.0,'stage':'on_ground','learning_mode':'ONLINE_JSBSIM','online_training':True,'require_offline_knowledge':True,'context':{'rtmo_run_context':{**run,'cycle_id':1}}}).to_dict()
        assert first['downstream_layers']['7']['feedback_routing']['layer2_no_change_ack']['persistent'] is False
        second=o.run_cycle({'transaction_id':'online-no-change-2','reference_time_s':3.0,'stage':'on_ground','learning_mode':'ONLINE_JSBSIM','online_training':True,'require_offline_knowledge':True,'context':{'rtmo_run_context':{**run,'cycle_id':2}}}).to_dict()
    finally:
        o.close(); clear_layer5_modules()
    route=((f2.calls[-1].get('context') or {}).get('layer7_feedback') or {}).get('Layer2') or {}
    assert route.get('persistence')=='TRANSIENT_IN_MEMORY' and route.get('learning_update') is False
    ingress=((second.get('provenance') or {}).get('online_previous_layer7_feedback') or {}).get('layer2_ingress') or {}
    assert ingress.get('present') is True and ingress.get('consumed') is True
    assert ingress.get('no_change_acknowledged') is True and ingress.get('adaptation_applied') is False
    assert second['conformance']['A_online_previous_l7_ingress_to_l2'] is True

def test_wingmpet_verification_certificate_is_self_contained_offline(tmp_path,monkeypatch):
    """OFFLINE FF must not require an Online PT_LIB commissioning affine map."""
    clear_layer5_modules(); monkeypatch.delenv("TDDT_LAYER5_ROOT",raising=False)
    l5=make_fake_layer5(tmp_path); cfg=make_cfg(tmp_path,l5); a=Layer5Adapter(cfg); a._ensure()
    class Phoenix:
        elevon_max=0.53
    a.engine.phoenix=Phoenix()
    a._verification_model_certificate={
        "ok":True,"simulation_only":True,
        "mixer":{"elevon_matrix_rad_per_norm":[[0.02,0.02],[-0.02,0.02]],"trim_rad":[-0.08,-0.08]},
        "trim":{"pitch_request_norm":0.0,"throttle_request_norm":0.3},
        "throttle_path":{"qualified_delta_from_operating_request_norm":[-0.1,0.1],"trim_norm":0.3,"gain_motor_norm_per_pilot_delta":1.0},
    }
    # Deliberately no runtime_throttle_affine: that belongs to Online commissioning.
    out=a._wingmpet_verification_mix([0.0,0.0,0.3,0.0])
    assert out["ok"] is True and out["physical"]==[-0.08,-0.08,0.3,0.3]
    bad=a._wingmpet_verification_mix([0.0,0.0,0.41,0.0])
    assert bad["ok"] is False and bad["reason"]=="wingmpet_verification_throttle_outside_qualified_neighborhood"
    clear_layer5_modules()
