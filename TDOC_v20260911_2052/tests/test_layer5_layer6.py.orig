    a5=Layer5Adapter(cfg); a6=Layer6OnlineAdapter(cfg,a5); calls=[]
    class P:
        def probe(self): return {'ok':True}
        def prepare(self): calls.append('prepare'); return {'ok':True,'prepared':True}
        def connect(self): calls.append('connect'); return {'ok':True,'connected':True}
        def prepare_control_session(self): calls.append('control_prepare'); return {'ok':True,'ready':True}
        def commission_control_path(self): calls.append('commission'); return {'ok':True,'schema':'PTLIB-Phoenix-control-commission-v1'}
        def close(self): pass
    a6._pt=P(); out=a6.prepare_online_control_session()
    assert out['ok'] is True and calls==['prepare','connect','control_prepare']
    clear_layer5_modules()

def test_layer6_pins_relative_ptlib_logs_to_external_root(tmp_path,monkeypatch):
    clear_layer5_modules(); monkeypatch.delenv("TDDT_LAYER5_ROOT",raising=False); monkeypatch.delenv("TDDT_PTLIB_ROOT",raising=False)
    l5=make_fake_layer5(tmp_path); ptroot=make_fake_ptlib(tmp_path); cfg=make_cfg(tmp_path,l5,ptroot); monkeypatch.setenv("TDDT_PTLIB_ROOT",str(ptroot))
    a5=Layer5Adapter(cfg); a6=Layer6OnlineAdapter(cfg,a5)
    class Logger:
        def __init__(self): self.directory=Path('logs')
        def write(self,name,text):
            self.directory.mkdir(parents=True,exist_ok=True); (self.directory/name).open('a').write(text+'\n')
    class Obj: pass
    class PT:
        def __init__(self): self.controller=None; self.lifecycle=None
        def probe(self): return {'ok':True}
        def prepare(self):
            self.controller=Obj(); self.controller.logger=Logger(); self.lifecycle=Obj(); self.lifecycle.logger=self.controller.logger
            self.controller.logger.write('communication.jsonl','prepare')
            return {'ok':True,'prepared':True}
        def connect(self):
            self.controller.logger.write('data_exchange.jsonl','connect')
            return {'ok':True,'connected':True}
        def close(self): pass
    pt=PT(); a6._pt=pt
    cwd=Path.cwd(); meta=a6._open_runtime_session(pt)
    assert Path.cwd()==cwd
    assert Path(pt.controller.logger.directory)==(ptroot/'logs').resolve()
    assert (ptroot/'logs/communication.jsonl').read_text().strip()=='prepare'
    assert (ptroot/'logs/data_exchange.jsonl').read_text().strip()=='connect'
    assert meta['ptlib_logging']['directory']==str((ptroot/'logs').resolve())
    assert not (cwd/'logs/communication.jsonl').exists()
    clear_layer5_modules()


def test_layer6_execution_evidence_correlates_tdoc_to_ptlib_command_ids(tmp_path,monkeypatch):
    clear_layer5_modules(); monkeypatch.delenv("TDDT_LAYER5_ROOT",raising=False); monkeypatch.delenv("TDDT_PTLIB_ROOT",raising=False)
    l5=make_fake_layer5(tmp_path); ptroot=make_fake_ptlib(tmp_path); cfg=make_cfg(tmp_path,l5,ptroot); monkeypatch.setenv("TDDT_PTLIB_ROOT",str(ptroot))
    a5=Layer5Adapter(cfg); a6=Layer6OnlineAdapter(cfg,a5)
    class Logger:
        def __init__(self): self.directory=(ptroot/'logs').resolve(); self.ids={}
        def latest_record_id(self,key): return self.ids.get(key)
    class Obj: pass
    class PT:
        def __init__(self):
            self.controller=Obj(); self.controller.logger=Logger(); self.lifecycle=Obj(); self.lifecycle.logger=self.controller.logger
        def probe(self): return {'ok':True}
        def prepare(self): return {'ok':True,'prepared':True}
        def connect(self): return {'ok':True,'connected':True}
        def safe_control_write(self,command):
            self.controller.logger.ids['actuator_command']='actuator_command:00000001'
            return {'ok':True,'command_sent':True,'stream_status':{'running':True,'send_count':1,'last_result':{'release_confirmation':{'ready':True,'released':True,'holding':False,'release_token_consumed':True}}}}
        def io_snapshot(self):
            self.controller.logger.ids['sensor_observation']='sensor_observation:00000008'
            self.controller.logger.ids['actuator_feedback']='actuator_feedback:00000003'
            return {'ok':True,'sensor_observation':{'imu':1},'environment_truth':{'x':2}}
        def close(self): pass
    pt=PT(); a6._pt=pt
    l5out={'ok':True,'result':{'ok':True,'snapshot_version':'v1','control_action':{'first_move':[0.1,-0.2,0.55,0.0]},'layer6_package':{'control_action':{'first_move':[0.1,-0.2,0.55,0.0]}},'gates':{'FINAL':True},'decision_id':'L5-D-9'}}
    out=a6.invoke({'layer5_output':l5out,'learning_mode':'ONLINE_JSBSIM','version':'v1','transaction_id':'TDOC-TX-9','request':{}})
    d=out['execution_evidence']['command_dispatch']
    assert out['status']=='EXECUTED' and out['actuation_executed'] is True
    assert d['tdoc_transaction_id']=='TDOC-TX-9' and d['layer5_decision_id']=='L5-D-9'
    assert d['ptlib_command_id']=='actuator_command:00000001'
    assert d['ptlib_actuator_feedback_id']=='actuator_feedback:00000003'
    assert d['ptlib_sensor_observation_id']=='sensor_observation:00000008'
    clear_layer5_modules()


