{
  "schema_version": "2.2",
  "twin_id": "MicroMetTwin",
  "domain": "climate/downscaling",
  "layer": 2,
  "model": "MicroMetTwin.fmu",
  "formalism": "micromet_formalism_v2.md",
  "fmi": "2.0 Co-Simulation",
  "state_outputs": [
    "temperature_local",
    "relative_humidity_local",
    "wind_speed_terrain",
    "wind_direction_terrain_deg",
    "surface_pressure_pa",
    "shortwave_radiation",
    "longwave_radiation",
    "precipitation_local",
    "wind_u_3dw",
    "wind_v_3dw",
    "diagnostic_vertical_wind",
    "wind_speed_3d",
    "air_density"
  ],
  "input_contract": {
    "forecast": "offline coarse/point forecast",
    "terrain": "shared terrain_obstacles.tif via Python adapter",
    "position": "WGS84 lon/lat + MSL/AGL",
    "time": "within forecast validity window"
  },
  "parameter_contract": {
    "barnes_filter_km": "configured by caller",
    "calibration": "explicit FMI calibration inputs",
    "3dw": "finite-difference/profile parameters"
  },
  "operating_domain": {
    "terrain_policy": "require-dem for TDDT",
    "vertical_reference": "explicit AGL/MSL",
    "forecast_range": "no silent extrapolation"
  },
  "constraints": [
    "finite outputs",
    "0<=relative_humidity_local<=100",
    "wind_speed_terrain>=0",
    "surface_pressure_pa>0",
    "formula_valid==1",
    "wind_3dw_valid required for 3DW quantities"
  ],
  "tolerances": {
    "continuity_residual": "diagnostic; application-specific threshold must be set by Layer 3/validation policy"
  },
  "context_contract": [
    "context_id",
    "stage_id",
    "operation_code",
    "CRP/SARG prior hooks optional"
  ],
  "feedback_contract": "field evidence may be logged in Layer 2 but persistent TEP update is slow/versioned/rollback-capable and must not occur on fast ticks",
  "architectural_exclusions": [
    "STD(t)",
    "network topology G(t)",
    "coupling K(t)",
    "network weights W(t)",
    "Center of Consistency C*(t)",
    "decision/control"
  ],
