<?xml version="1.0" encoding="utf-8"?>
<?xml-stylesheet type="text/xsl" href="http://jsbsim.sf.net/JSBSimScript.xsl"?>
<runscript xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="http://jsbsim.sf.net/JSBSimScript.xsd"
    name="Testing phoenix_v3">

  <description>
    Phoenix dual-rotor tailsitter under ArduPilot control
  </description>

  <use aircraft="phoenix_v3" initialize="reset"/>

  <input port="5505"/>

  <output name="127.0.0.1" type="SOCKET" port="5506" protocol="UDP" rate="1200.000000000" precision="17">
    <property caption="TDDT_BODY_RATES_V1_P_RAD_S"> velocities/p-rad_sec </property>
    <property caption="TDDT_BODY_RATES_V1_Q_RAD_S"> velocities/q-rad_sec </property>
    <property caption="TDDT_BODY_RATES_V1_R_RAD_S"> velocities/r-rad_sec </property>
  </output>
  <run start="0" end="10000000" dt="0.000833">
    <property value="0"> simulation/notify-time-trigger </property>
  </run>

</runscript>
