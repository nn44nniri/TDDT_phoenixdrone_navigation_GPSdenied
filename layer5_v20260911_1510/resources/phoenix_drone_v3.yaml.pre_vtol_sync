sensor_layout:
  contract_version: '1.1'
  deployment_scope: ArduPilot_SITL_plus_JSBSim_JSON_integration
  pt_lib_boundary_policy: latest_value_hold_at_10_Hz_control_tick; producer/native rates remain unchanged
  sensors:
    imu:
      role: 3_axis_accelerometer_and_3_axis_gyroscope
      simulator_source: JSBSim_bridge_JSON_imu.accel_body_and_imu.gyro
      ardupilot_backend: JSON_SITL_simulated_IMU
      mavlink_messages: [SCALED_IMU, RAW_IMU, SCALED_IMU2]
      pt_lib_group: IMU
      pt_lib_access: read_latest_valid_sample
      required_for_ready: true
    magnetometer:
      role: 3_axis_magnetic_field
      simulator_source: ArduPilot_SITL_environment_derived_from_simulated_state
      ardupilot_backend: SITL_magnetometer
      mavlink_messages: [SCALED_IMU, RAW_IMU, SCALED_IMU2]
      pt_lib_group: MAGNETOMETER
      pt_lib_access: read_latest_valid_sample
      required_for_ready: false
    barometer:
      role: pressure_altitude_pressure_temperature
      simulator_source: ArduPilot_SITL_atmosphere_from_simulated_state
      ardupilot_backend: SITL_barometer
      mavlink_messages: [SCALED_PRESSURE, SCALED_PRESSURE2, SCALED_PRESSURE3]
      pt_lib_group: PRESSURE
      pt_lib_access: read_latest_valid_sample
      required_for_ready: true
    airspeed:
      role: pitot_true_or_calibrated_airspeed_integration_signal
      simulator_source: JSBSim_bridge_JSON_airspeed
      ardupilot_backend: SITL_airspeed_ARSPD_TYPE_100
      mavlink_messages: [AIRSPEED, VFR_HUD]
      pt_lib_group: AIRSPEED
      pt_lib_access: read_latest_valid_sample
      required_for_ready: false
    position:
      role: integration_truth_position_not_validated_GNSS_denied_estimator
      simulator_source: JSBSim_bridge_JSON_latitude_longitude_altitude
      ardupilot_backend: JSON_SITL_position
      mavlink_messages: [GLOBAL_POSITION_INT]
      pt_lib_group: POSITION
      pt_lib_access: read_latest_valid_sample
      required_for_ready: true
    velocity:
      role: NED_velocity
      simulator_source: JSBSim_bridge_JSON_velocity
      ardupilot_backend: JSON_SITL_velocity
      mavlink_messages: [GLOBAL_POSITION_INT, VFR_HUD]
      pt_lib_group: VELOCITY
      pt_lib_access: read_latest_valid_sample
      required_for_ready: false
    attitude:
      role: roll_pitch_yaw_and_body_rates
      simulator_source: JSBSim_bridge_JSON_attitude
      ardupilot_backend: simulator_primary_AHRS_for_this_SITL_profile
      mavlink_messages: [ATTITUDE]
      pt_lib_group: ATTITUDE
      pt_lib_access: read_latest_valid_sample
      required_for_ready: true
    battery:
      role: integration_voltage_current_remaining
      simulator_source: JSBSim_bridge_JSON_battery_integration_model
      ardupilot_backend: battery_monitor_BATT_MONITOR_4
      mavlink_messages: [BATTERY_STATUS, SYS_STATUS]
      pt_lib_group: BATTERY
      pt_lib_access: read_latest_valid_sample
      required_for_ready: false
    gps_bootstrap:
      role: SITL_bootstrap_only_disableable_for_GNSS_denied_test
      simulator_source: ArduPilot_SITL_GPS_from_simulated_position
      ardupilot_backend: SIM_GPS1_ENABLE_runtime_switch
      mavlink_messages: [GPS_RAW_INT]
      pt_lib_group: GPS
      pt_lib_access: read_and_enable_disable_for_integration_test
      required_for_ready: false
    wind:
      role: ardupilot_wind_estimate_telemetry
      simulator_source: simulator_environment
      ardupilot_backend: SITL_wind_state
      mavlink_messages: [WIND]
      pt_lib_group: WIND
      pt_lib_access: read_latest_valid_sample
      required_for_ready: false
      truth_source: JSBSim bridge current_state.wind / atmosphere wind properties
      mavlink_semantics: WIND is an ArduPilot estimate/telemetry signal and may differ from simulator environment truth
      reporting_policy: show JSBSim truth and MAVLink WIND estimate separately; never relabel estimate as truth
    ultrasonic_wind:
      role: 3_axis_ultrasonic_wind_measurement
      physical_sensor: true
      installed_on_vehicle: true
      original_phoenixdrone_sensor: false
      integration_status: contract_and_decoder_ready_for_real_vehicle; optional_in_current_SITL
      ardupilot_backend: external_ultrasonic_sensor_forwarded_by_ArduPilot_or_ArduPilot_side_companion
      transport_contract: MAVLink NAMED_VALUE_FLOAT triplet UWIND_N/UWIND_E/UWIND_D in m/s
      transport_messages: [NAMED_VALUE_FLOAT]
      mavlink_messages: [ULTRASONIC_WIND]
      pt_lib_group: ULTRASONIC_WIND
      pt_lib_access: read_latest_valid_sample
      required_for_ready: false
      frame: NED
      units: m/s
      truth_source: independent_from_JSBSim_truth_and_ArduPilot_WIND_estimate
      sitl_policy: do_not_synthesize_from_JSBSim_truth; absence remains explicit unless a sensor emulator/backend publishes the triplet
      reporting_policy: preserve as independent sensor_observation for truth/estimate accuracy analysis
  note: Sensor producers remain at their native rates. PT_LIB normalizes observation only at its 10 Hz control boundary; it does not down-clock JSBSim or ArduPilot inner loops. JSBSim wind truth, the physical ultrasonic wind observation, and ArduPilot WIND estimate are three independent semantics.

