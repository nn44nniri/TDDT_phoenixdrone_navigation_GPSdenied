      min_deg: -30.36676314193363
      max_deg: 30.36676314193363
      trim_deg: 0.0
      joint_limit_rad: 0.53
      limit_provenance: source_identified_official_phoenix_sdf
  motors:
    left_motor:
      servo_output: 3
      ardupilot_function: 73
      role: throttle_left
      min_norm: 0.0
      max_norm: 1.0
    right_motor:
      servo_output: 4
      ardupilot_function: 74
      role: throttle_right
      min_norm: 0.0
      max_norm: 1.0
  logical_control_input:
    roll: aileron_norm [-1,+1]
    pitch: elevator_norm [-1,+1]
    throttle: throttle_norm [0,1]
    yaw: rudder_norm [-1,+1]
  mixing_note: ArduPilot performs elevon mixing and optional differential-thrust yaw;
    pt_lib sends pilot-domain roll/pitch/throttle/yaw, not direct motor RPM.
autopilot_runtime:
  vehicle: ArduPlane
  forward_flight_only: true
  parameters:
    SERVO1_FUNCTION: 77
    SERVO2_FUNCTION: 78
    SERVO3_FUNCTION: 73
    SERVO4_FUNCTION: 74
    SERVO1_MIN: 1000
    SERVO1_TRIM: 1500
    SERVO1_MAX: 2000
    SERVO2_MIN: 1000
    SERVO2_TRIM: 1500
    SERVO2_MAX: 2000
    SERVO3_MIN: 1000
    SERVO3_TRIM: 1000
    SERVO3_MAX: 2000
    SERVO4_MIN: 1000
    SERVO4_TRIM: 1000
    SERVO4_MAX: 2000
    RUDD_DT_GAIN: 0.0
    AHRS_EKF_TYPE: 10
    ARSPD_TYPE: 100
    BATT_MONITOR: 4
    BATT_CAPACITY: 2200
    TERRAIN_ENABLE: 0
    TERRAIN_FOLLOW: 0
  parameter_provenance:
    servo_functions: ArduPlane documented elevon/twin-throttle output functions
    RUDD_DT_GAIN: kept disabled in the simplified JSBSim forward-flight model; source
      motor law is recorded but differential-thrust control has not been validated
      in ArduPlane
    AHRS_EKF_TYPE: SITL-only simulator attitude backend; do not transfer blindly to
      real hardware
    ARSPD_TYPE: SITL-only simulator airspeed backend so JSON airspeed is used consistently
    BATT_MONITOR: SITL integration battery monitor enabled so JSON bridge voltage/current
      are observable
    BATT_CAPACITY: Phoenix profile capacity in mAh; telemetry model remains integration-only
    TERRAIN_ENABLE: disabled because ArduPilot terrain-follow requires its own matching
      terrain database; the supplied DEM is coupled to JSBSim physics in v0.6.0
    TERRAIN_FOLLOW: disabled until a validated terrain data source is explicitly provided
simulation_assumptions:
  jsbsim_model_fidelity: source_informed_simplified_forward_flight_model
  jsbsim_aircraft_model: phoenix_v3
  forward_flight_air_start_only: true
  tailsitter_hover_transition_validated: false
  source_identified_data:
  - base-link inertia and inertial pose
  - motor time constants/max speed/thrust constant/moment constant
  - calibrated Gazebo propwash aerodynamic coefficients and CP locations
  engineering_estimates_still_required:
  - conventional forward-flight stability/control derivatives used by phoenix_v3.xml
  - JSBSim coordinate-frame reduction of the full Gazebo geometry
  - cruise trim control values
  initial_agl_m: 100.0
  home_alt_msl_m_default: 0.0
  home_alt_source: runtime terrain start sample
  confidence: source_informed_integration_model_not_flight_validated
  validation_boundary: Suitable for SITL integration/mission-continuity testing only;
    not a validated replacement for the official Gazebo/Simulink Phoenix dynamics.
  analytic_release_seed:
    airspeed_m_s: 13.5
    alpha_deg: 8.8
    elevator_norm: -0.15
    collective_throttle_norm: 0.3
    fidelity: engineering_equilibrium_seed_using_source_inertia_motor_law_and_estimated_forward_flight_derivatives
    validation: not_measured_trim; Docker JSBSim runtime readiness/watchdog remains
      authoritative
