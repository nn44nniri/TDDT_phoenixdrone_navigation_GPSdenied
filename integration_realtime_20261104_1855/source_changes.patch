+def test_landing_contact_does_not_confuse_flare_descent_with_ground_support():
+    from tddt_tdoc.realtime import ContactSupport
+    support=ContactSupport()
+    for k in range(40):
+        assert support.update(k*.1,.8-k*.02,.2,.03) is None
+    for k in range(10):
